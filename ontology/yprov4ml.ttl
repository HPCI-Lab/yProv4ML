@prefix : <https://hpci-lab.github.io/yProv4ML/ontology.html#> .
@prefix yprov4ml: <https://hpci-lab.github.io/yProv4ML/ontology.html#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix provml: <https://w3id.org/provml#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# --- Ontology Metadata ---
<https://hpci-lab.github.io/yProv4ML/ontology.html> a owl:Ontology ;
    rdfs:label "yProv4ML Ontology" ;
    rdfs:comment "Ontology defining machine learning execution provenance matching yProv schema patterns." ;
    owl:versionInfo "1.1" .

# --- Classes ---
provml:Model a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Model" .

provml:Dataset a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Dataset" .

provml:HyperParameter a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "HyperParameter" .

provml:Metric a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Metric" .

yprov4ml:ExecutionActivity a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Execution Activity" .

# --- Data Properties (Activity Metadata) ---
yprov4ml:provenancePath a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:artifactURI a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:experimentDirectory a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:experimentName a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:runID a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:pythonVersion a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:PID a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:hostName a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:timeZone a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:globalRank a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:runtimeType a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:operatingSystem a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:release a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:processor a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

yprov4ml:machine a rdf:Property ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .

# --- Data Properties (Entity Attributes & Stats) ---
yprov4ml:fullLabel a rdf:Property ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string .

yprov4ml:fileSizeInBytes a rdf:Property ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string .

yprov4ml:checksum a rdf:Property ;
    rdfs:domain provml:Dataset ;
    rdfs:range xsd:string .

# --- Model Metadata Properties ---
yprov4ml:parentTotalParameters a rdf:Property ;
    rdfs:domain provml:Model ;
    rdfs:range xsd:int .

yprov4ml:parentWeightsMemoryLoad a rdf:Property ;
    rdfs:domain provml:Model ;
    rdfs:range xsd:double .

yprov4ml:parentModelTotalMemoryLoad a rdf:Property ;
    rdfs:domain provml:Model ;
    rdfs:range xsd:double .

yprov4ml:weightsTotalParameters a rdf:Property ;
    rdfs:domain provml:Model ;
    rdfs:range xsd:int .

yprov4ml:weightsWeightsMemoryLoad a rdf:Property ;
    rdfs:domain provml:Model ;
    rdfs:range xsd:double .

yprov4ml:weightsModelTotalMemoryLoad a rdf:Property ;
    rdfs:domain provml:Model ;
    rdfs:range xsd:double .

# --- Dataset Statistics Properties ---
yprov4ml:datasetStatBatchSize a rdf:Property ;
    rdfs:domain provml:Dataset ;
    rdfs:range xsd:string .

yprov4ml:datasetStatNumWorkers a rdf:Property ;
    rdfs:domain provml:Dataset ;
    rdfs:range xsd:string .

yprov4ml:datasetStatShuffle a rdf:Property ;
    rdfs:domain provml:Dataset ;
    rdfs:range xsd:boolean .

yprov4ml:datasetStatTotalSteps a rdf:Property ;
    rdfs:domain provml:Dataset ;
    rdfs:range xsd:string .

yprov4ml:datasetStatTotalSamples a rdf:Property ;
    rdfs:domain provml:Dataset ;
    rdfs:range xsd:string .

yprov4ml:datasetStatTotalBatches a rdf:Property ;
    rdfs:domain provml:Dataset ;
    rdfs:range xsd:string .

# --- Metric Properties ---
yprov4ml:context a rdf:Property ;
    rdfs:domain provml:Metric ;
    rdfs:range xsd:string .

yprov4ml:source a rdf:Property ;
    rdfs:domain provml:Metric ;
    rdfs:range xsd:string .

yprov4ml:meanMetricValue a rdf:Property ;
    rdfs:domain provml:Metric ;
    rdfs:range xsd:double .

prov:finalMetricValue a rdf:Property ;
    rdfs:domain provml:Metric ;
    rdfs:range xsd:double .